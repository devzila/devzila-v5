# DevZila — Apache config for clean (extensionless) URLs

RewriteEngine On

# If the site is served from a subdirectory, set this to that path, e.g. /myapp/
# RewriteBase /

# One public host. www and plain http fold into https://devzila.com in a single hop.
# Local hosts (Herd, localhost) are not matched. A TLS-terminating proxy that sets
# X-Forwarded-Proto is not redirected again.
RewriteCond %{HTTP_HOST} ^www\.devzila\.com$ [NC]
RewriteRule ^ https://devzila.com%{REQUEST_URI} [R=301,L]

RewriteCond %{HTTP_HOST} ^devzila\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteRule ^ https://devzila.com%{REQUEST_URI} [R=301,L]

# Use index.php as the directory index so "/" serves the homepage
DirectoryIndex index.php

# Text files (robots.txt, llms.txt, CSS, SVG) are UTF-8
AddDefaultCharset UTF-8

# Unknown URLs get the branded 404 page (with a real 404 status)
ErrorDocument 404 /404.php

# Pass HTTP Basic Auth credentials through to PHP (needed by the admin panel
# on some CGI/FastCGI setups).
CGIPassAuth On
RewriteCond %{HTTP:Authorization} .+
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# ── Security: block direct web access to sensitive files ──
<FilesMatch "\.(sql|md)$">
  Require all denied
</FilesMatch>
<Files "config.php">
  Require all denied
</Files>
<Files "config.sample.php">
  Require all denied
</Files>
<Files "LocalValetDriver.php">
  Require all denied
</Files>
# Never serve the include partials or library files directly
RewriteRule ^(partials|lib)/ - [F,L]

# ── Clean URLs ──

# 0) The site used to be static HTML. Send those URLs to the current page.
#    Real files such as the Google verification HTML are left untouched.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^index\.html$ / [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)\.html$ /$1 [R=301,L]

# The blog renderer is not a public URL. Send it to the blog index in one hop
# so it does not redirect to /blog-post and then 404.
RewriteRule ^blog-post(\.php)?$ /blog [R=301,L]

# 1) Redirect "/index" or "/index.php" to "/"
RewriteCond %{THE_REQUEST} \s/+index(\.php)?[\s?] [NC]
RewriteRule ^ /? [R=301,L]

# 2) Redirect any external "/page.php" request to the extensionless "/page"
RewriteCond %{THE_REQUEST} \s/+([^.\s?]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Redirect "/page/" to "/page" so every page has exactly one URL
#    (real directories such as /admin/ are left alone)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{THE_REQUEST} \s/+([^\s?]*[^\s?/])/+[\s?]
RewriteRule ^ /%1 [R=301,L]

# 4) XML sitemap: /sitemap.xml -> sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# 5) Pretty blog post URLs: /blog/{slug} -> blog-post.php?slug={slug}
RewriteRule ^blog/([A-Za-z0-9_-]+)$ blog-post.php?slug=$1 [L,QSA]

# 6) Internally map an extensionless URL to its .php file (no redirect, so POST works)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.+)$ $1.php [L]

# ── Performance: compression and browser caching ──
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # CSS/JS URLs carry a ?v=<mtime> version, so they are safe to cache for long
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
</IfModule>
